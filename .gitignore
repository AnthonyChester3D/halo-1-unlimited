# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Build files
build/
.ninja_*
build.ninja

# Generated configs
compile_commands.json

# The January build and the Xbox SDK (tools/xdk_headers.py reads the
# build's PDB); never commit
*.exe
*.pdb
xbox/
!source/**/xbox/

# Locally extracted proprietary game data (never commit)
assets/
# (but the high-res assets, drawn for the port: tools/hud_assets.py)
!port/assets/
original/

# CI build outputs (tools/ci_build.py)
dist/

# Halo 1 Unlimited (port/oxbox/): the build, and files made from your own copy of the game
/build-xbox/
/default_16Xbox.xbe
*.xbe
/port/oxbox/pictures.bin
/port/oxbox/online_games.dxt3
# the installer's build (nxdk puts its objects beside the sources)
/port/oxbox/installer/bin/
/port/oxbox/installer/main.exe
/port/oxbox/installer/*.obj
/port/oxbox/installer/*.c.d
/port/oxbox/installer/keys.h
/port/oxbox/installer/notices.h
/port/oxbox/installer/mbedtls_obj/
/port/third_party/monocypher/*.obj
/port/third_party/monocypher/*.c.d
*.oxpk
# signing keys' secret halves (port/oxbox/tools/oxsign.py): never in the repository
*.oxkey
