# Halo 1 Unlimited settings (opence.ini)
#
# Put this file next to the game's default.xbe (your Halo folder) and name it opence.ini. A copy at T:\opence.ini
# (E:\TDATA\4d530004\opence.ini) is read after it, and its settings win.
#
# Every setting below shows its default and is switched off with a # in front, so this file changes nothing as it is.
# To change one, delete the # at the start of its line and edit the number. One setting per line, "name = number".
# Lines starting with # are ignored. The game reads this file once, when it starts.
# oxbox_log.txt says which settings it took, as lines like "settings: fps_counter from D:\opence.ini".


# ---- General ----

# The frame rate in the bottom right corner: green at 30, red under. 1 = on.
# fps_counter = 0

# The audio chip's reverb program. 0 = off, only for a console whose BIOS can't take it (no sound, or a crash at start).
# audio_effects = 1


# ---- The showcase screensaver (the main menu, left alone) ----

# 0 = the attract movies instead.
# showcase = 1

# Seconds the main menu waits before the showcase starts (5 and up).
# showcase_seconds = 75

# Bots in each showcase match, 0 to 15 (7 is only an example). Left out: the map's suggested players, less one.
# showcase_bots = 7

# Bots drop out one at a time while the frame rate stays under this. 0 = never.
# showcase_min_fps = 15


# ---- Online play ----

# 0 = no internet play (no ONLINE PLAY item).
# online = 1

# 0 = don't ask the router to forward the game's port (UPnP).
# online_upnp = 1

# 0 = no games with PC players: none listed, and PCs can't join yours.
# crossplay = 1

# The game's port. 0 = chosen for you. Set one only if you forward a port by hand on your router.
# online_tunnel_port = 0

# Where games are listed, and where your public address is found: host:port lists, comma between.
# Left out: OpenCE's own servers. (Nothing after the list on its line: the whole rest of the line is read.)
# online_brokers = host:port, host:port
# online_stun = host:port, host:port


# ---- Network test (for working out connection problems) ----

# The test at start-up (address, DNS, game-list servers). 0 = skip it.
# net_test = 1

# 1 = the test's lines on the main menu too, not only in oxbox_log.txt.
# net_test_screen = 0

# A PC on your network that the test sends a line to over TCP (a.b.c.d), and its port.
# net_test_host = 192.168.1.10
# net_test_port = 5555

# A DNS server for the test (a.b.c.d). Left out: the router's.
# net_test_dns = 1.1.1.1

# A fixed address for the Xbox (a.b.c.d). Left out: from the router (DHCP).
# net_test_static = 192.168.1.50

# Online play needs this on. Leave it alone.
# net_test_bypass = 1


# ---- Developer logs (they make the logs bigger; leave them off unless you're asked for them) ----

# The bots' log: a line every 10 seconds in oxbox_log.txt, and opence_bot_log.txt with the spots where bots gave up.
# bot_log = 0

# The performance and memory log: a CSV file a map in perf\ beside the game.
# perf_log = 0

# (with perf_log) A frame longer than this many milliseconds gets a line of its own.
# perf_slow_frame_ms = 34

# (with perf_log) How often, in milliseconds, the graphics chip is asked whether it's busy. 0 = never.
# perf_gpu_sample_ms = 1
